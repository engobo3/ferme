{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "paths": {
      "@/*": ["./src/*"],
      "@diaspora-trust/core-logic": ["../../libs/core-logic/src/index.ts"],
      "@diaspora-trust/core-logic/*": ["../../libs/core-logic/src/*"]
    }
  },
  "include": [
    "src",
    "../../libs/core-logic/src/**/*.ts"
  ]
}
